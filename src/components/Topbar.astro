---
const { pathname } = Astro.url;
const currentLang = pathname.startsWith('/') ? pathname.split('/')[1] : 'en';

const links = [
    { name: '/docs', href: `/${currentLang}/docs` },
    { name: '/blog', href: `/${currentLang}/blog` },
    { name: '/about', href: `/${currentLang}/about` },
];
---

<header class="bg-gray-800 text-white p-4">
    <nav class="flex justify-between items-center">
        <div class="text-lg font-bold">My Website</div>
        <ul class="flex space-x-4">
            {links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class={`hover:underline ${pathname === link.href ? 'font-bold' : ''}`}
                    >
                        {link.name}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
</header>