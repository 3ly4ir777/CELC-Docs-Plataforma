---
// Obtenemos la ruta actual desde la petición de Astro
const { pathname } = Astro.url;

// Detectamos si el usuario está actualmente en la versión en inglés
const isEnglish = pathname.startsWith('/en');

// Calculamos la ruta equivalente para el otro idioma
let targetUrl = '#';
if (isEnglish) {
  // Si está en /en/docs/..., cambiamos a /es/docs/...
  targetUrl = pathname.replace(/^\/en/, '/es');
} else if (pathname.startsWith('/es')) {
  // Si está en /es/docs/..., cambiamos a /en/docs/...
  targetUrl = pathname.replace(/^\/es/, '/en');
} else {
  // Si está en la raíz (/), mandamos al idioma opuesto
  targetUrl = '/en/docs/login';
}
---

<header class="sticky top-0 z-50 w-full backdrop-blur border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    
    <!-- Logo y Nombre -->
    <div class="flex items-center gap-3">
      <a href="/es/docs/login" class="flex items-center gap-2 font-bold text-lg text-indigo-600 dark:text-indigo-400">
        <span class="text-2xl">🎓</span>
        <span>CELC <span class="text-slate-500 font-normal">Docs</span></span>
      </a>
    </div>

    <!-- Buscador (Placeholder) -->
    <div class="flex-1 max-w-md hidden sm:block">
      <div class="relative">
        <input 
          type="text" 
          placeholder={isEnglish ? "Search documentation..." : "Buscar en la documentación..."} 
          class="w-full pl-9 pr-4 py-1.5 text-sm rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        />
        <span class="absolute left-3 top-2 text-slate-400 text-sm">🔍</span>
      </div>
    </div>

    <!-- Selector de Idioma Dinámico -->
    <div class="flex items-center gap-3 text-sm">
      <a 
        href={targetUrl}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 font-medium transition-colors"
        title={isEnglish ? "Cambiar a Español" : "Switch to English"}
      >
        <span>🌐</span>
        <span>{isEnglish ? 'EN' : 'ES'}</span>
        <span class="text-xs text-slate-400">({isEnglish ? 'Switch to ES' : 'Cambiar a EN'})</span>
      </a>
    </div>

  </div>
</header>