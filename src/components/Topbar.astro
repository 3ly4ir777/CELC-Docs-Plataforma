    <!-- Logo y Nombre -->
    <div class="flex items-center gap-3">
      <a href="/es/docs/backend" class="flex items-center gap-2 font-bold text-lg text-indigo-600 dark:text-indigo-400">
        <span class="text-2xl">🎓</span>
        <span>CELC <span class="text-slate-500 font-normal">Docs</span></span>
      </a>
    </div>

    <!-- Buscador (placeholder estático por ahora) -->
