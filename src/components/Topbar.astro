---
import { getCollection } from 'astro:content';

const { pathname } = Astro.url;
const isEnglish = pathname.startsWith('/en');
const currentLang = isEnglish ? 'en' : 'es';

// Obtenemos todos los documentos del idioma actual
const allDocs = await getCollection('docs');
const langDocs = allDocs.filter(doc => doc.id.startsWith(`${currentLang}/`));

// 1. Datos para el buscador
const searchableDocs = langDocs.map(doc => ({
  title: doc.data.title,
  subtitle: doc.data.subtitle || '',
  url: `/${currentLang}/docs/${doc.id.replace(/^(es|en)\//, '')}`
}));

// 2. Secciones únicas para los botones del Topbar
const sections = Array.from(new Set(langDocs.map(doc => doc.data.section || 'General')));

let targetUrl = '#';
if (isEnglish) {
  targetUrl = pathname.replace(/^\/en/, '/es');
} else if (pathname.startsWith('/es')) {
  targetUrl = pathname.replace(/^\/es/, '/en');
} else {
  targetUrl = '/en/docs/login';
}
---

<header class="sticky top-0 z-50 w-full backdrop-blur border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    
    <!-- Botón Hamburguesa (Móvil) + Logo -->
    <div class="flex items-center gap-3">
      <button 
        id="mobile-menu-btn" 
        onclick="window.dispatchEvent(new CustomEvent('toggle-mobile-menu'))"
        class="md:hidden p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg focus:outline-none cursor-pointer"
        aria-label="Abrir Menú">
        <span class="text-xl">☰</span>
      </button>

      <!-- Logo Rojo Oscuro -->
      <a href={`/${currentLang}/docs/login`} class="flex items-center gap-2 font-bold text-lg text-red-700 dark:text-red-500">
        <span class="text-2xl">🎓</span>
        <span>CELC <span class="text-red-900 dark:text-red-400 font-semibold">Docs</span></span>
      </a>
    </div>

    <!-- Acceso Rápido a Secciones (Desktop) -->
    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
      {sections.map(section => (
        <a 
          href={`#section-${section.toLowerCase().replace(/\s+/g, '-')}`}
          class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-300 hover:text-red-700 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          {section}
        </a>
      ))}
    </nav>

    <!-- Buscador Interactivo -->
    <div class="flex-1 max-w-xs sm:max-w-md relative hidden sm:block">
      <div class="relative">
        <input 
          type="text" 
          id="doc-search-input"
          placeholder={isEnglish ? "Search documentation..." : "Buscar en la documentación..."} 
          autocomplete="off"
          class="w-full pl-9 pr-4 py-1.5 text-sm rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-red-600"
        />
        <span class="absolute left-3 top-2 text-slate-400 text-sm">🔍</span>
      </div>

      <!-- Resultados de búsqueda -->
      <div 
        id="search-results" 
        class="hidden absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-xl max-h-80 overflow-y-auto z-50 p-2 space-y-1"
      >
      </div>
    </div>

    <!-- Acciones (Idioma + Tema) -->
    <div class="flex items-center gap-2 text-sm">
      <button 
        id="theme-toggle" 
        type="button" 
        class="p-2 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors"
        aria-label="Cambiar Tema"
      >
        <span id="theme-toggle-dark-icon" class="hidden">🌙</span>
        <span id="theme-toggle-light-icon" class="hidden">☀️</span>
      </button>

      <!-- Botón Idioma -->
      <a 
        href={targetUrl}
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 font-medium transition-colors"
      >
        <span>🌐</span>
        <span>{isEnglish ? 'EN' : 'ES'}</span>
      </a>
    </div>

  </div>
</header>

<!-- Script para la lógica del buscador y del toggle de tema -->
<script is:inline define:vars={{ searchableDocs }}>
  const input = document.getElementById('doc-search-input');
  const resultsContainer = document.getElementById('search-results');
  let selectedIndex = -1;

  if (input && resultsContainer) {
    function getResultItems() {
      return resultsContainer.querySelectorAll('a');
    }

    function updateSelection(items) {
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('bg-red-50', 'dark:bg-red-950/50', 'text-red-700');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-red-50', 'dark:bg-red-950/50', 'text-red-700');
        }
      });
    }

    input.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      selectedIndex = -1;

      if (!query) {
        resultsContainer.classList.add('hidden');
        resultsContainer.innerHTML = '';
        return;
      }

      // Filtrar documentos que coincidan en título o subtítulo
      const filtered = searchableDocs.filter(doc => 
        doc.title.toLowerCase().includes(query) || 
        doc.subtitle.toLowerCase().includes(query)
      );

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `<div class="p-3 text-xs text-slate-400 text-center">Sin resultados para "${query}"</div>`;
      } else {
        resultsContainer.innerHTML = filtered.map((doc, idx) => `
          <a href="${doc.url}" data-index="${idx}" class="block p-2 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700/50 transition-colors">
            <div class="font-semibold text-sm text-red-700 dark:text-red-400">${doc.title}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 truncate">${doc.subtitle}</div>
          </a>
        `).join('');
      }
      resultsContainer.classList.remove('hidden');
    });

    // Navegación con Flechas Teclado
    input.addEventListener('keydown', (e) => {
      const items = getResultItems();
      if (!items.length || resultsContainer.classList.contains('hidden')) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        items[selectedIndex].click();
      } else if (e.key === 'Escape') {
        resultsContainer.classList.add('hidden');
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !resultsContainer.contains(e.target)) {
        resultsContainer.classList.add('hidden');
      }
    });
  }

  // Toggle Tema
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      themeToggleLightIcon?.classList.remove('hidden');
      themeToggleDarkIcon?.classList.add('hidden');
    } else {
      themeToggleDarkIcon?.classList.remove('hidden');
      themeToggleLightIcon?.classList.add('hidden');
    }
  }

  // Sincronizar ícono inicial
  updateIcons();
  themeToggleBtn?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    updateIcons();
  });

  // Disparar evento para abrir/cerrar menú móvil en el Sidebar
  const mobileBtn = document.getElementById('mobile-menu-btn');
  mobileBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toggle-mobile-menu'));
  });
</script>