---
const { pathname } = Astro.url;
const isEnglish = pathname.startsWith('/en');

// Prefijo de idioma dinámico (/es o /en)
const lang = isEnglish ? 'en' : 'es';
---

<nav class="space-y-6 text-sm">
  <div>
    <h3 class="font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-xs mb-2">
      {isEnglish ? 'General Usage' : 'Uso General'}
    </h3>
    <ul class="space-y-1">
      <li>
        <a href={`/${lang}/docs/login`} class="block px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          {isEnglish ? 'Login & Access' : 'Inicio de Sesión'}
        </a>
      </li>
      <li>
        <a href={`/${lang}/docs/instalacion-pwa`} class="block px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          {isEnglish ? 'Install App (PWA) 📱' : 'Instalar App (PWA) 📱'}
        </a>
      </li>
      <li>
        <a href={`/${lang}/docs/vistas-perfil`} class="block px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          {isEnglish ? 'Profile Views by Role' : 'Vistas de Perfil por Rol'}
        </a>
      </li>
    </ul>
  </div>

  <div>
    <h3 class="font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider text-xs mb-2">
      {isEnglish ? 'Admin & API' : 'Administración & API'}
    </h3>
    <ul class="space-y-1">
      <li>
        <a href={`/${lang}/docs/crud-usuarios`} class="block px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          {isEnglish ? 'User Management (CRUD) 🔒' : 'Gestión de Usuarios (CRUD) 🔒'}
        </a>
      </li>
      <li>
        <a href={`/${lang}/docs/backend`} class="block px-3 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800">
          {isEnglish ? 'Backend & Architecture' : 'Backend & Arquitectura'}
        </a>
      </li>
    </ul>
  </div>
</nav>